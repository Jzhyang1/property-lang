/* 7+5 expands into 7 +(5.). which
	because of the `.` it is evaluated at compile-time
	to be the constant 12 */
0 do (
	x assign[12];
	x.print;
) jit compile import();

/* 0 do (...) -> this returns 0 */
0 do (
	1 then{2+3 print.}else{99 print.};
) jit compile import();

0 do (
	0 print_hello definition{
		"Hello, " + "World!" print;
		0;
	};
) jit compile import(print_hello);

0 do (
	0 print_hello;
) jit compile import();

_ test output_assert["12\n5\nHello, World!\n"];